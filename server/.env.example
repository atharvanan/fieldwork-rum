PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/fieldwork

# JWT Secrets (must be long random strings in production)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_ORIGIN=http://localhost:3000

# Role assignment (anyone registering with this email becomes an admin)
ADMIN_EMAIL=

# Ingestion rate limits & retention
INGEST_RATE_PER_MIN=600
REGISTER_RATE_PER_HOUR=20
RETENTION_DAYS=30

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
