PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/fieldwork
# Must be set to long random strings in production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_ORIGIN=http://localhost:3000
# Anyone who registers with this email becomes an admin
ADMIN_EMAIL=
# Max ingest requests per project key per minute (raise for load tests)
INGEST_RATE_PER_MIN=600
# Sign-ups allowed per IP per hour
REGISTER_RATE_PER_HOUR=20
# Raw events older than this are deleted automatically (TTL index)
RETENTION_DAYS=30
